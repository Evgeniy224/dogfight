{
  "name": "dogfight",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "dev:server": "node --watch server/index.js",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev\""
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "terminal-graph": "^1.3.0"
  }
}
